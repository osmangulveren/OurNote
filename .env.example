# Database (SQLite for local; switch provider in prisma/schema.prisma to "postgresql" for production)
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public site URL (used for Stripe redirects)
APP_URL="http://localhost:3000"

# Brand + selling entity (shown to buyers; your manufacturers are never shown)
BRAND_NAME="Anatolia Home"
COMPANY_LEGAL_NAME="Your Company SRL"
COMPANY_ADDRESS="Str. Exemplu 1, 010101 Bucharest, Romania"
COMPANY_VAT="RO12345678"
COMPANY_EMAIL="orders@example.com"
COMPANY_IBAN="RO49 AAAA 1B31 0075 9384 0000"
COMPANY_BANK="Banca Transilvania"

# Pricing
VAT_RATE_RO="21"          # Romanian VAT %, charged to Romanian buyers
FREIGHT_PER_CBM="0"       # EUR per m3; 0 = delivery included in prices
TRUCK_CAPACITY_CBM="82"   # usable m³ of a 13.6 m trailer (nominal ~90 m³; furniture rarely packs tighter)
DEPOSIT_PERCENT="30"      # deposit when the buyer chooses "deposit + balance before loading"
TRANSIT_DAYS="6"          # typical road time Türkiye → EU store, used for delivery estimates

# Stripe (optional). Without a key, buyers pay by bank transfer (proforma).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Seeded admin login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
