// SQLite for local development. For production switch provider to "postgresql"
// and point DATABASE_URL at your Postgres instance.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("BUYER") // ADMIN | BUYER
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  cartItems    CartItem[]
  orders       Order[]
  createdAt    DateTime   @default(now())
}

model Company {
  id         String   @id @default(cuid())
  name       String
  vatNumber  String?
  country    String // ISO 3166-1 alpha-2
  city       String
  address    String
  postalCode String
  phone      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  users      User[]
  orders     Order[]
  samples    SampleRequest[]
  createdAt  DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  slug             String      @unique
  name             String
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  shortDescription String      @default("")
  description      String      @default("")
  images           String      @default("[]") // JSON string[]
  price            Float // EUR per unit, excl. VAT, for quantities below the first tier
  priceTiers       String      @default("[]") // JSON {minQty, price}[]
  moq              Int         @default(1)
  unit             String      @default("pcs")
  unitsPerCarton   Int         @default(1)
  leadTimeDays     Int         @default(21)
  dimensions       String      @default("") // e.g. "190 x 90 x 85 cm"
  weightKg         Float       @default(0) // packed weight per unit
  volumeM3         Float       @default(0) // packed volume per unit
  material         String      @default("")
  colors           String      @default("[]") // JSON string[]
  specs            String      @default("[]") // JSON {label, value}[]
  active           Boolean     @default(true)
  featured         Boolean     @default(false)
  rrp              Float       @default(0) // suggested retail price incl. VAT, for the buyer's margin calculator
  tags             String      @default("[]") // JSON string[] e.g. ["Sofa bed","Storage","Curved"]
  shape            String      @default("{}") // JSON 3D model parameters (see lib/shape.ts)
  // Internal only — never shown to buyers (you sell under your own brand)
  supplierName     String      @default("")
  supplierPrice    Float       @default(0)
  sourceUrl        String      @default("")
  cartItems        CartItem[]
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  color     String  @default("")

  @@unique([userId, productId, color])
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  status          String       @default("PENDING_PAYMENT")
  paymentMethod   String // STRIPE | BANK_TRANSFER
  paymentStatus   String       @default("UNPAID") // UNPAID | DEPOSIT_PAID | PAID | REFUNDED
  paymentPlan     String       @default("FULL") // FULL | DEPOSIT
  depositAmount   Float        @default(0)
  paidAmount      Float        @default(0)
  stripeSessionId String?
  subtotal        Float
  freight         Float
  vatRate         Float
  vatAmount       Float
  total           Float
  vatNote         String       @default("")
  totalVolumeM3   Float        @default(0)
  // Delivery address snapshot
  deliveryName    String
  deliveryAddress String
  deliveryCity    String
  deliveryPostal  String
  deliveryCountry String
  deliveryPhone   String
  notes           String       @default("")
  shipmentId      String?
  shipment        Shipment?    @relation(fields: [shipmentId], references: [id])
  items           OrderItem[]
  events          OrderEvent[]
  claims          Claim[]
  paidAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime     @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String
  name      String
  color     String  @default("")
  unitPrice Float
  quantity  Int
  lineTotal Float
  volumeM3  Float   @default(0)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String   @default("")
  createdAt DateTime @default(now())
}

// One truck (TIR) carrying several store orders from Türkiye to Europe
model Shipment {
  id           String          @id @default(cuid())
  code         String          @unique
  truckPlate   String
  trailerPlate String          @default("")
  driverName   String          @default("")
  driverPhone  String          @default("")
  carrier      String          @default("")
  origin       String          @default("Türkiye")
  route        String          @default("") // e.g. "Istanbul → Kapıkule → Sofia → Bucharest"
  stage        String          @default("PLANNED")
  // Groupage: open trucks that stores can book space on at checkout
  bookable     Boolean         @default(false)
  cutoffAt     DateTime? // last day to book + pay deposit
  plannedDepartureAt DateTime?
  capacityM3   Float           @default(82) // usable m³
  departedAt   DateTime?
  eta          DateTime?
  orders       Order[]
  events       ShipmentEvent[]
  createdAt    DateTime        @default(now())
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  stage      String
  location   String
  note       String   @default("")
  createdAt  DateTime @default(now())
}

// Physical fabric swatch kit requested by a store
model SampleRequest {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  fabrics   String // JSON string[]
  note      String   @default("")
  status    String   @default("REQUESTED") // REQUESTED | SENT
  createdAt DateTime @default(now())
}

// Damage / missing item report after delivery
model Claim {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String
  quantity    Int
  kind        String // DAMAGED | MISSING | WRONG_ITEM
  description String
  status      String   @default("OPEN") // OPEN | RESOLVED
  resolution  String   @default("")
  createdAt   DateTime @default(now())
}
